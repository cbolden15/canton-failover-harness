# Inject these variables through your shell or secret manager.
# Or copy this to a private .env and pass --env-file .env explicitly.
# Example: npm start -- setup --env-file .env
# No environment file is loaded automatically.
# Dedicated external-party Ed25519 secret key: base64-encoded 64-byte key,
# in the format produced by the Canton Wallet SDK. Never use a real funds key.
CANTON_TEST_SIGNING_KEY=
CANTON_A_CLIENT_SECRET=
CANTON_B_CLIENT_SECRET=
